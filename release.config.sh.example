#
# Copy this file to release.config.sh (which is gitignored) and fill in your own
# values. release.sh sources it automatically. You can also export these
# variables in your shell instead.

# SHA-1 hash of your "Developer ID Application" certificate.
# Find it with: security find-identity -v -p codesigning
THREAD_SIGN_ID=""

# Your Apple Developer team ID (10 characters).
THREAD_TEAM_ID=""

# Keychain profile holding your notarization credential. Create it with:
#   xcrun notarytool store-credentials "thread-notary" \
#     --apple-id "you@example.com" --team-id "$THREAD_TEAM_ID" \
#     --password "app-specific-password"
THREAD_NOTARY_PROFILE="thread-notary"

# Public URL that the updates/ folder is served from, with a trailing slash.
# This must match SUFeedURL in Thread/Info.plist. If the two disagree, already
# installed builds will quietly stop receiving updates.
THREAD_DOWNLOAD_URL_PREFIX="https://raw.githubusercontent.com/salesforce-misc/thread/main/updates/"

# --- publish.sh ---------------------------------------------------------------

# The repository that serves the Sparkle feed (and, for this project, the source).
THREAD_PUBLISH_REMOTE="https://github.com/salesforce-misc/thread.git"
THREAD_PUBLISH_REPO="salesforce-misc/thread"

# Branch on that repository which the feed is served from.
THREAD_FEED_BRANCH="main"

# Address publish.sh expects to be committing as. Left empty, no check is made —
# and a repository with no user.email of its own will commit under one derived
# from your machine's hostname, which is then public.
THREAD_COMMIT_EMAIL=""
